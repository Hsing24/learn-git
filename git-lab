import subprocess

def get_user_display_name(engine: GitEngine) -> str:
    """Get configured Git user name from local repo or global config."""
    code, out, _ = engine.run_git("config", "user.name", check=False)
    if code == 0 and out.strip() and out.strip() != "User":
        return out.strip()
    try:
        res = subprocess.run(["git", "config", "--global", "user.name"], capture_output=True, text=True, check=False)
        if res.returncode == 0 and res.stdout.strip() and res.stdout.strip() != "User":
            return res.stdout.strip()
    except Exception:
        pass
    return ""

def personalize_story(story_text: str, user_name: str) -> str:
    if not user_name or not story_text:
        return story_text
    return (
        story_text
        .replace("「菜鳥，", f"「{user_name}，")
        .replace("「菜鳥……", f"「{user_name}……")
        .replace("「欸菜鳥，", f"「欸 {user_name}，")
        .replace("「菜鳥！", f"「{user_name}！")
        .replace("從小菜鳥的角度", f"從新人 {user_name} 的角度")
        .replace("身為剛入職的新人", f"身為剛入職的新人 {user_name}")
        .replace("身為最沒包袱的新人", f"身為最沒包袱的新人 {user_name}")
        .replace("身為新人", f"身為新人 {user_name}")
        .replace("身為菜鳥", f"身為新人 {user_name}")
        .replace("強哥交給你第一份", f"強哥交給 {user_name} 第一份")
        .replace("展開職場生存記！", f"{user_name} 的職場生存記正式開演！")
    )

def cmd_list(engine: GitEngine):
    state = engine.get_state()
    active_id = state.get("active_scenario")
    completed = set(state.get("completed_scenarios", []))

    curriculum_meta = {item["id"]: item for item in get_ordered_level_items()}

    info_list = []
    for sc in SCENARIOS:
        if sc.id in completed:
            st = "PASSED"
        elif sc.id == active_id:
            st = "ACTIVE"
        else:
            st = "TODO"
        
        meta = curriculum_meta.get(sc.id, {})
        info_list.append({
            "id": sc.id,
            "title": sc.title,
            "difficulty": meta.get("difficulty", sc.difficulty),
            "status": st,
            "chapterTitle": meta.get("chapterTitle", ""),
            "chapterSummary": meta.get("chapterSummary", ""),
            "displayNum": meta.get("displayNum", sc.id)
        })
    print_scenarios_table(info_list)


def cmd_start(engine: GitEngine, target: str):
    sc = get_scenario(target)
    if not sc:
        print(f"\n{red('❌ 找不到關卡：')} {target}")
        print(f"{dim('請輸入')} {yellow('./git-lab list')} {dim('查看可用關卡列表。')}\n")
        return

    print(f"\n{dim('正在為你建置情境環境... 關卡：')}{bold(sc.id)} - {sc.title}")
    try:
        sc.setup(engine)
        engine.set_active_scenario(sc.id)
    except Exception as e:
        print(f"{red('❌ 建立情境時發生錯誤：')} {e}")
        return

    user_name = get_user_display_name(engine)
    print_scenario_briefing(
        sc.id,
        sc.title,
        sc.difficulty,
        personalize_story(sc.story, user_name),
        sc.goals,
        sc.next_steps
    )
    print(f"  {yellow(bold('👉 請切換至練習目錄開始操作：'))} {green(bold('cd workspace'))}")
    launcher = "./git-lab" if (engine.workspace / "git-lab").exists() else "../git-lab"
    print(f"  {dim(f'(在 workspace 內可直接使用原生 Git 指令，驗收請執行 {launcher} verify)')}\n")

def cmd_status(engine: GitEngine):
    state = engine.get_state()
    active_id = state.get("active_scenario")
    if not active_id:
        print_banner()
        print(f"\n{dim('目前尚未啟動任何關卡。')}")
        print(f"{dim('輸入')} {yellow('./git-lab list')} {dim('挑選關卡，或輸入')} {yellow('./git-lab start 01')} {dim('開始第一關！')}\n")
        return

    sc = SCENARIO_MAP.get(active_id)
    if not sc:
        print(f"{red('❌ 關卡資料異常，請重新 start。')}")
        return

    user_name = get_user_display_name(engine)
    print_scenario_briefing(
        sc.id,
        sc.title,
        sc.difficulty,
        personalize_story(sc.story, user_name),
        sc.goals,
        sc.next_steps
    )

def cmd_hint(engine: GitEngine):
    state = engine.get_state()
    active_id = state.get("active_scenario")
    if not active_id:
        print(f"\n{dim('目前尚未啟動任何關卡。請先使用')} {yellow('./git-lab start <ID>')}\n")
        return

    sc = SCENARIO_MAP.get(active_id)
    if not sc or not sc.hints:
        print(f"\n{dim('本關卡暫無額外提示。')}\n")
        return

    count = engine.increment_hint_count(sc.id)
    hint_idx = min(count - 1, len(sc.hints) - 1)
    
    hint_text = sc.hints[hint_idx]
    lines = [
        f"{yellow(bold(f'提示 ({hint_idx + 1}/{len(sc.hints)}):'))}",
        f"  {hint_text}",
    ]
    if hint_idx + 1 < len(sc.hints):
        lines.append("")
        lines.append(f"{dim('如果還需要更具體的指引，可以再次輸入')} {yellow(bold('./git-lab hint'))}")

    print()
    print_card(f"💡 闖關提示 — {sc.title}", lines, border_color=yellow)
    print()

def cmd_verify(engine: GitEngine):
    state = engine.get_state()
    active_id = state.get("active_scenario")
    if not active_id:
        print(f"\n{dim('目前尚未啟動任何關卡。請先使用')} {yellow('./git-lab start <ID>')}\n")
        return

    sc = SCENARIO_MAP.get(active_id)
    if not sc:
        print(f"{red('❌ 找不到當前關卡資料。')}")
        return

    passed, message = sc.verify(engine)
    print()
    if passed:
        engine.mark_scenario_passed(sc.id)
        # Find next scenario
        idx = next((i for i, s in enumerate(SCENARIOS) if s.id == sc.id), -1)
        next_cmd = None
        if idx != -1 and idx + 1 < len(SCENARIOS):
            next_sc = SCENARIOS[idx + 1]
            launcher = "./git-lab" if (engine.workspace / "git-lab").exists() else "../git-lab"
            next_cmd = f"{launcher} start {next_sc.id}"
        print_success_card(sc.title, message, next_cmd)
    else:
        print_fail_card(sc.title, message)
    print()

def cmd_reset(engine: GitEngine):
    state = engine.get_state()
    active_id = state.get("active_scenario")
    if not active_id:
        print(f"\n{dim('目前尚未啟動任何關卡。')}\n")
        return

    sc = SCENARIO_MAP.get(active_id)
    if not sc:
        print(f"{red('❌ 關卡資料異常。')}")
        return

    print(f"\n{yellow('🔄 正在重設當前關卡至初始情境...')} {bold(sc.id)} - {sc.title}")
    try:
        sc.setup(engine)
    except Exception as e:
        print(f"{red('❌ 重設時發生錯誤：')} {e}")
        return

    user_name = get_user_display_name(engine)
    print_scenario_briefing(
        sc.id,
        sc.title,
        sc.difficulty,
        personalize_story(sc.story, user_name),
        sc.goals,
        sc.next_steps
    )
    print(f"{green('✔ 環境已重設！你可以重新嘗試操作。')}\n")

def cmd_pr_merge(engine: GitEngine, branch: str):
    """Simulate a reviewed PR merge against the configured bare origin."""
    code, remote_url, err = engine.run_git("remote", "get-url", "origin", check=False)
    if code != 0 or not remote_url.strip():
        print(f"\n{red('❌ 找不到 origin 遠端：')} {err.strip()}\n")
        return

    with tempfile.TemporaryDirectory(prefix="git-lab-pr-merge-") as temp_dir:
        checkout = Path(temp_dir) / "review"
        code, out, err = engine.run_git("clone", remote_url.strip(), str(checkout), check=False)
        if code != 0:
            print(f"\n{red('❌ 無法建立 PR 審查副本：')} {(err or out).strip()}\n")
            return

        remote_branch = f"refs/remotes/origin/{branch}"
        code, _, _ = engine.run_git("-C", str(checkout), "show-ref", "--verify", "--quiet", remote_branch, check=False)
        if code != 0:
            print(f"\n{red('❌ 遠端分支不存在：')} origin/{branch}\n")
            return

        code, _, _ = engine.run_git(
            "-C", str(checkout), "merge-base", "--is-ancestor", "origin/main", remote_branch, check=False
        )
        if code != 0:
            print(f"\n{red('❌ PR 分支尚未包含最新 origin/main，請先 rebase 並安全推送。')}\n")
            return

        code, out, err = engine.run_git(
            "-C", str(checkout), "merge", "--no-ff", remote_branch,
            "-m", f"Merge pull request '{branch}'", check=False
        )
        if code != 0:
            print(f"\n{red('❌ PR 合併發生衝突：')} {(err or out).strip()}\n")
            return

        code, out, err = engine.run_git("-C", str(checkout), "push", "origin", "main", check=False)
        if code != 0:
            print(f"\n{red('❌ 無法更新遠端 main：')} {(err or out).strip()}\n")
            return

        code, out, err = engine.run_git("-C", str(checkout), "push", "origin", "--delete", branch, check=False)
        if code != 0:
            print(f"\n{red('❌ PR 已合併，但無法刪除遠端分支：')} {(err or out).strip()}\n")
            return

    print(f"\n{green('✔ PR 已模擬合併至 origin/main，並刪除 origin/' + branch)}\n")

def cmd_tree(engine: GitEngine):
    if not (engine.repo_dir / ".git").exists():
        print(f"\n{dim('目前尚未初始化 Git repo。')}\n")
        return

    print(f"\n{bold('🌲 當前 Git Commit 拓撲圖：')}\n")
    code, out, _ = engine.run_git(
        "log",
        "--graph",
        "--all",
        "--decorate",
        "--oneline",
        "--color=always",
        check=False
    )
    if code != 0 or not out.strip():
        print(dim("  (目前尚無 Commit 紀錄)"))
    else:
        for line in out.splitlines():
            print(f"  {line}")
    print()

def print_help():
    print_banner()
    help_text = f"""
{bold('💡 使用方式 (Usage):')}
  {yellow('./git-lab list')}            {dim('列出所有關卡與目前挑戰狀態')}
  {yellow('./git-lab start <ID>')}      {dim('進入指定關卡，建立模擬情境 (例: ./git-lab start 03)')}
  {yellow('./git-lab status')}          {dim('查看目前關卡的任務目標與故事')}
  {yellow('./git-lab hint')}            {dim('獲取逐步提示與指令指引')}
  {yellow('./git-lab verify')}          {dim('驗證目前的 Git 狀態是否達成通關目標')}
  {yellow('./git-lab reset')}           {dim('如果不小心搞砸了，一鍵重設當前關卡')}
  {yellow('./git-lab tree')}            {dim('視覺化查看目前的分支與 Commit 樹狀結構')}
  {yellow('./git-lab pr merge <branch>')} {dim('模擬審核通過的 PR 合併至 origin/main，並刪除遠端分支')}
"""
    print(help_text)

def main():
    engine = GitEngine(REPO_ROOT)
    # Level 36 deliberately starts before git init; status/verify must not initialize it.
    if engine.get_state().get("active_scenario") != "36":
        engine.init_repo_if_needed()

    args = sys.argv[1:]
    if not args:
        state = engine.get_state()
        if state.get("active_scenario"):
            cmd_status(engine)
        else:
            print_help()
        return

    cmd = args[0].lower()
    if cmd in ["list", "ls"]:
        cmd_list(engine)
    elif cmd in ["start", "init", "run"]:
        if len(args) < 2:
            print(f"\n{red('請指定關卡 ID')}，例如：{yellow('./git-lab start 01')}\n")
        else:
            cmd_start(engine, args[1])
    elif cmd in ["status", "info"]:
        cmd_status(engine)
    elif cmd in ["hint", "hints", "help-me"]:
        cmd_hint(engine)
    elif cmd in ["verify", "check", "test"]:
        cmd_verify(engine)
    elif cmd in ["reset", "restart"]:
        cmd_reset(engine)
    elif cmd in ["tree", "log", "graph"]:
        cmd_tree(engine)
    elif cmd == "pr" and len(args) >= 3 and args[1].lower() == "merge":
        cmd_pr_merge(engine, args[2])
    elif cmd in ["--help", "-h", "help"]:
        print_help()
    else:
        print(f"\n{red('未知的指令：')} {args[0]}")
        print_help()

if __name__ == "__main__":
    main()
